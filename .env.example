# ==========================================
# Placement Assistant Environment Variables
# ==========================================

# Environment Mode
NODE_ENV=development

# Backend Express API
API_PORT=4000
WEB_ORIGIN=http://localhost:5173

# Databases
# MongoDB Atlas or local MongoDB. Use the same URI for Express and FastAPI.
MONGODB_URI=mongodb://localhost:27017/placement_assistant
MONGODB_DATABASE=placement_assistant
REDIS_URL=redis://localhost:6379
# LangGraph checkpoint persistence (uses the MongoDB connection above)
CHECKPOINT_MONGODB_DATABASE=ipca_db
CHECKPOINT_MONGODB_COLLECTION=langgraph_checkpoints
CHECKPOINT_MONGODB_WRITES_COLLECTION=langgraph_checkpoint_writes

# Authentication & Security
JWT_SECRET=replace_with_a_long_random_jwt_secret_min_32_chars
JWT_REFRESH_SECRET=replace_with_a_different_long_jwt_refresh_secret_min_32_chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7
# Same public OAuth Web client ID on the API and frontend; no client secret needed.
GOOGLE_CLIENT_ID=

# OAuth Social Logins (Google, GitHub, LinkedIn)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Email Verification (SMTP)
# Optional in development (OTP codes print to server console if not configured).
# Required in production to send real verification emails (e.g. Gmail App Password, Resend, SendGrid).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=HiPlacement <no-reply@hiplacement.com>

# File Uploads
UPLOAD_MAX_BYTES=5242880
LOCAL_STORAGE_PATH=./uploads

# Multi-agent AI Service (FastAPI)
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TOKEN=replace_with_a_long_random_internal_service_secret_min_32_chars
AI_SERVICE_TIMEOUT_MS=300000

# Live job providers. Jobicy and Remotive work without keys; add both Adzuna
# values only when you need broader India and other Adzuna-supported markets.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOB_FETCH_TIMEOUT_MS=10000

# Google Gemini API (Shared across Backend and Multi-agent AI)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest
# FastAPI uses one fallback only for an unavailable/overloaded model.
# Quota and authentication failures never trigger model fallback.
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest
# Native-audio Live API model used for full-duplex mock interviews.
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=1536
ATLAS_VECTOR_INDEX=knowledge_vector_index

# Shared resume storage (Supabase Storage)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=resumes

# Frontend (Vite)
VITE_API_URL=/api/v1
VITE_GOOGLE_CLIENT_ID=

